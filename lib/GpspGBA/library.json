{
  "name": "GpspGBA",
  "version": "1.0.0",
  "description": "gpSP Game Boy Advance core with an Ink-boy SD-card VFS adapter",
  "keywords": [
    "gba",
    "emulator",
    "gpsp"
  ],
  "frameworks": "arduino",
  "platforms": "espressif32",
  "build": {
    "srcDir": "src",
    "includeDir": "include",
    "flags": "-D__LIBRETRO__ -DINLINE=inline -DHAVE_STRINGS_H -DHAVE_STDINT_H -DHAVE_INTTYPES_H -DROM_BUFFER_SIZE=4 -Isrc/gpsp -Isrc/gpsp/libretro -Isrc/gpsp/libretro/libretro-common/include"
  }
}
